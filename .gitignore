# Dataset (regenerated by scripts/01-08 — see README) and training artifacts
data/
runs/
logs/
weights/
__pycache__/
*.pyc

# Pretrained base weights (auto-downloaded by ultralytics on first run)
/yolov8s.pt
/yolov8s-cls.pt

# Raw source zips consumed by merge scripts (not meant to be versioned)
/*.zip

# Model checkpoints: only the production models are tracked (via Git LFS below).
# Backups / dead-end experiments stay local — see CLAUDE.md for why they exist.
models/*
!models/carjim_best.pt
!models/wbc_classifier.pt
!models/carjim_wbc_plt.pt

# Runtime input/output image folders (user data, not source)
/Imagens a serem analisadas/
/Imagens analisadas/

# Raw slide-scan videos/photos (source material for scripts/14, not versioned)
/Videos/
/Pictures/

# Teacher-corrected WBC crops for the kNN bank (scripts/15) -- user data
/Exemplos de leucocitos/
